# Flask secret key – set to a long random string in production
YOUR_SECRET_KEY=your-very-secret-key-here

# PostgreSQL connection details
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# SMTP email credentials (used for the contact form)
Your_SMTP_EMAIL=your-email@gmail.com
Your_SMTP_PASSWORD=your-app-password
